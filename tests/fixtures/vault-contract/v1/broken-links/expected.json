{
  "contract": "vault-contract/v1",
  "case": "broken-links",
  "assertions": [
    {
      "id": "broken-note-targets",
      "equals": [
        "Missing"
      ]
    },
    {
      "id": "broken-fragments",
      "equals": [
        "Existing#Absent",
        "Existing#^absent-block"
      ]
    },
    {
      "id": "ignored-link-like-text",
      "equals": [
        "Not-A-Link",
        "Also-Not-A-Link"
      ]
    }
  ]
}
