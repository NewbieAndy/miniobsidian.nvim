{
  "contract": "vault-contract/v1",
  "case": "basic-vault",
  "assertions": [
    {
      "id": "notes",
      "equals": [
        "Notes/Welcome",
        "Projects/Demo",
        "Templates/Daily"
      ]
    },
    {
      "id": "ignored",
      "equals": [
        "Archive/Ignored"
      ]
    },
    {
      "id": "resolve",
      "query": "Projects/Demo",
      "equals": "Projects/Demo"
    },
    {
      "id": "frontmatter-preserve",
      "path": "Notes/Welcome.md",
      "unknown_key": "custom_field",
      "unknown_value": "keep-me"
    }
  ]
}
